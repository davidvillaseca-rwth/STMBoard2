#include "main.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Debug platform: tune player + pulse sensor + every input pin, streamed to the
   laptop page (debug.html) at 50 lines per second.

   Pot (A1)  = tempo          Buttons: UP/DOWN = volume, LEFT = pause/resume,
   Pulse (A0) = heart rate             RIGHT = restart tune, blue B1 = mute
   Page commands (one line each, ending with newline):
     m mute, p pause, + volume up, - volume down, r restart,
     2:NN / 3:NN = LED2 / LED3 brightness 0..100, 2f1 / 3f1 = keep LED on, 2f0 / 3f0 = back to music */

#define SHIFT          4     /* notes x4 = two octaves up, louder on the piezo */
#define VOL_START      10    /* buzzer volume in % duty (50 = loudest) */
#define VOL_MAX        50
#define BPM_MIN        40
#define BPM_MAX        160
#define LED_START_S    40    /* start brightness of the sliders, 0..100 (duty = s*s/100) */
#define LED_ACTIVE_HIGH 1

#define LED2_Pin       GPIO_PIN_10   /* D6 */
#define LED2_GPIO_Port GPIOB
#define LED3_Pin       GPIO_PIN_8    /* D7 */
#define LED3_GPIO_Port GPIOA

/* ---------- pins that are watched (order = bit number in the page) ---------- */
typedef struct { GPIO_TypeDef *port; uint16_t pin; uint8_t pull; } pin_t;   /* pull: 0 none, 1 pull-up, 2 leave alone */
static const pin_t pins[] = {
  {GPIOC, GPIO_PIN_5, 1},  /*  0 D0  */   {GPIOC, GPIO_PIN_4, 1},  /*  1 D1  */
  {GPIOA, GPIO_PIN_10, 1}, /*  2 D2  left  */ {GPIOB, GPIO_PIN_3, 1}, /*  3 D3  down  */
  {GPIOB, GPIO_PIN_5, 1},  /*  4 D4  right */ {GPIOB, GPIO_PIN_4, 1}, /*  5 D5  up    */
  {GPIOB, GPIO_PIN_10, 2}, /*  6 D6  LED2  */ {GPIOA, GPIO_PIN_8, 2}, /*  7 D7  LED3  */
  {GPIOA, GPIO_PIN_9, 1},  /*  8 D8  */      {GPIOC, GPIO_PIN_7, 2},  /*  9 D9  buzzer */
  {GPIOB, GPIO_PIN_6, 1},  /* 10 D10 */      {GPIOA, GPIO_PIN_7, 1},  /* 11 D11 */
  {GPIOA, GPIO_PIN_6, 1},  /* 12 D12 */      {GPIOA, GPIO_PIN_5, 0},  /* 13 D13 (LD2) */
  {GPIOB, GPIO_PIN_9, 1},  /* 14 D14 */      {GPIOB, GPIO_PIN_8, 1},  /* 15 D15 */
  {GPIOA, GPIO_PIN_4, 1},  /* 16 A2  */      {GPIOB, GPIO_PIN_0, 1},  /* 17 A3  */
  {GPIOC, GPIO_PIN_1, 1},  /* 18 A4  */      {GPIOC, GPIO_PIN_0, 1},  /* 19 A5  */
  {GPIOC, GPIO_PIN_13, 0}, /* 20 B1 blue button */
};
#define N_PINS (sizeof(pins) / sizeof(pins[0]))
enum { P_LEFT = 2, P_DOWN = 3, P_RIGHT = 4, P_UP = 5, P_B1 = 20 };

static UART_HandleTypeDef hlpuart1;
ADC_HandleTypeDef hadc1;

void SystemClock_Config(void);
void Error_Handler(void);

/* ---------- serial: output ring buffer + input, both serviced from the TIM6 interrupt ---------- */
#define TXN 2048
static volatile uint8_t  txbuf[TXN];
static volatile uint16_t txh = 0, txt = 0;
#define RXN 64
static volatile uint8_t  rxbuf[RXN];
static volatile uint8_t  rxh = 0, rxt = 0;

static void tx_str(const char *s)
{
  uint16_t h = txh;
  while (*s) {
    uint16_t n = (uint16_t)((h + 1) % TXN);
    if (n == txt) return;            /* buffer full: drop the rest */
    txbuf[h] = (uint8_t)*s++;
    h = n;
    txh = h;
  }
}

/* ---------- LED dimming + serial service, 20 kHz ---------- */
static volatile uint8_t led2_on = 0, led3_on = 0;           /* set by the music */
static volatile uint8_t led2_force = 0, led3_force = 0;     /* kept on from the page */
static volatile uint8_t led2_s = LED_START_S, led3_s = LED_START_S;            /* slider 0..100 */
static volatile uint8_t led2_duty = LED_START_S * LED_START_S / 100, led3_duty = LED_START_S * LED_START_S / 100;
static void leds(int l2, int l3) { led2_on = l2 ? 1 : 0; led3_on = l3 ? 1 : 0; }

void TIM6_DAC_IRQHandler(void)
{
  static uint8_t step = 0;
  TIM6->SR = 0;
  if (++step >= 100) step = 0;
  int l2 = (led2_on || led2_force) && (step < led2_duty);
  int l3 = (led3_on || led3_force) && (step < led3_duty);
  if (!LED_ACTIVE_HIGH) { l2 = !l2; l3 = !l3; }
  LED2_GPIO_Port->BSRR = l2 ? (uint32_t)LED2_Pin : ((uint32_t)LED2_Pin << 16);
  LED3_GPIO_Port->BSRR = l3 ? (uint32_t)LED3_Pin : ((uint32_t)LED3_Pin << 16);

  uint32_t isr = LPUART1->ISR;
  if ((isr & (1u << 7)) && txt != txh) {          /* TXE: send next byte */
    LPUART1->TDR = txbuf[txt];
    txt = (uint16_t)((txt + 1) % TXN);
  }
  if (isr & (1u << 5)) {                          /* RXNE: store the received byte */
    uint8_t c = (uint8_t)LPUART1->RDR;
    uint8_t n = (uint8_t)((rxh + 1) % RXN);
    if (n != rxt) { rxbuf[rxh] = c; rxh = n; }
  }
  if (isr & (1u << 3)) LPUART1->ICR = (1u << 3);          /* clear overrun */
}

static void tim6_init(void)
{
  RCC->APB1ENR1 |= RCC_APB1ENR1_TIM6EN;
  (void)RCC->APB1ENR1;
  TIM6->PSC = 169;                  /* 1 MHz */
  TIM6->ARR = 49;                   /* 20 kHz */
  TIM6->EGR = TIM_EGR_UG;
  TIM6->SR = 0;
  TIM6->DIER = TIM_DIER_UIE;
  NVIC_SetPriority(TIM6_DAC_IRQn, 3);
  NVIC_EnableIRQ(TIM6_DAC_IRQn);
  TIM6->CR1 = TIM_CR1_CEN;
}

static void uart_init(void)
{
  GPIO_InitTypeDef g = {0};
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_LPUART1_CLK_ENABLE();
  g.Pin = GPIO_PIN_2 | GPIO_PIN_3;
  g.Mode = GPIO_MODE_AF_PP;
  g.Pull = GPIO_NOPULL;
  g.Speed = GPIO_SPEED_FREQ_LOW;
  g.Alternate = GPIO_AF12_LPUART1;
  HAL_GPIO_Init(GPIOA, &g);

  hlpuart1.Instance = LPUART1;
  hlpuart1.Init.BaudRate = 115200;
  hlpuart1.Init.WordLength = UART_WORDLENGTH_8B;
  hlpuart1.Init.StopBits = UART_STOPBITS_1;
  hlpuart1.Init.Parity = UART_PARITY_NONE;
  hlpuart1.Init.Mode = UART_MODE_TX_RX;
  hlpuart1.Init.HwFlowCtl = UART_HWCONTROL_NONE;
  hlpuart1.Init.OneBitSampling = UART_ONE_BIT_SAMPLE_DISABLE;
  hlpuart1.Init.ClockPrescaler = UART_PRESCALER_DIV1;
  hlpuart1.AdvancedInit.AdvFeatureInit = UART_ADVFEATURE_NO_INIT;
  if (HAL_UART_Init(&hlpuart1) != HAL_OK) Error_Handler();
}

/* ---------- ADC: A0 = pulse (IN1), A1 = pot (IN2) ---------- */
static void adc_init(void)
{
  GPIO_InitTypeDef g = {0};
  __HAL_RCC_ADC12_CLK_ENABLE();
  __HAL_RCC_GPIOA_CLK_ENABLE();
  g.Pin = GPIO_PIN_0 | GPIO_PIN_1;
  g.Mode = GPIO_MODE_ANALOG;
  g.Pull = GPIO_NOPULL;
  HAL_GPIO_Init(GPIOA, &g);

  hadc1.Instance = ADC1;
  hadc1.Init.ClockPrescaler = ADC_CLOCK_SYNC_PCLK_DIV4;
  hadc1.Init.Resolution = ADC_RESOLUTION_12B;
  hadc1.Init.DataAlign = ADC_DATAALIGN_RIGHT;
  hadc1.Init.GainCompensation = 0;
  hadc1.Init.ScanConvMode = ADC_SCAN_DISABLE;
  hadc1.Init.EOCSelection = ADC_EOC_SINGLE_CONV;
  hadc1.Init.LowPowerAutoWait = DISABLE;
  hadc1.Init.ContinuousConvMode = DISABLE;
  hadc1.Init.NbrOfConversion = 1;
  hadc1.Init.DiscontinuousConvMode = DISABLE;
  hadc1.Init.ExternalTrigConv = ADC_SOFTWARE_START;
  hadc1.Init.ExternalTrigConvEdge = ADC_EXTERNALTRIGCONVEDGE_NONE;
  hadc1.Init.DMAContinuousRequests = DISABLE;
  hadc1.Init.Overrun = ADC_OVR_DATA_PRESERVED;
  hadc1.Init.OversamplingMode = DISABLE;
  if (HAL_ADC_Init(&hadc1) != HAL_OK) Error_Handler();
  if (HAL_ADCEx_Calibration_Start(&hadc1, ADC_SINGLE_ENDED) != HAL_OK) Error_Handler();
}

/* average n conversions of one channel; returns the SUM */
static uint32_t adc_sum(uint32_t ch, int n)
{
  ADC_ChannelConfTypeDef c = {0};
  c.Channel = ch;
  c.Rank = ADC_REGULAR_RANK_1;
  c.SamplingTime = ADC_SAMPLETIME_47CYCLES_5;
  c.SingleDiff = ADC_SINGLE_ENDED;
  c.OffsetNumber = ADC_OFFSET_NONE;
  c.Offset = 0;
  HAL_ADC_ConfigChannel(&hadc1, &c);
  uint32_t sum = 0;
  for (int i = 0; i < n; i++) {
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    sum += HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
  }
  return sum;
}

/* ---------- buzzer: D9 = PC7 = TIM3_CH2 PWM ---------- */
static uint32_t cur_arr = 999;
static volatile int note_sounding = 0;   /* a note is being played (even if muted) */
static int muted = 0, paused = 0;
static uint32_t vol = VOL_START;

static void buzzer_init(void)
{
  GPIO_InitTypeDef g = {0};
  __HAL_RCC_GPIOC_CLK_ENABLE();
  g.Pin = GPIO_PIN_7;
  g.Mode = GPIO_MODE_AF_PP;
  g.Pull = GPIO_NOPULL;
  g.Speed = GPIO_SPEED_FREQ_LOW;
  g.Alternate = GPIO_AF2_TIM3;
  HAL_GPIO_Init(GPIOC, &g);

  RCC->APB1ENR1 |= RCC_APB1ENR1_TIM3EN;
  (void)RCC->APB1ENR1;
  TIM3->PSC  = 169;
  TIM3->ARR  = 999;
  TIM3->CCR2 = 0;
  TIM3->CCMR1 = (6u << TIM_CCMR1_OC2M_Pos) | TIM_CCMR1_OC2PE;
  TIM3->CCER = TIM_CCER_CC2E;
  TIM3->CR1  = TIM_CR1_ARPE | TIM_CR1_CEN;
  TIM3->EGR  = TIM_EGR_UG;
}

static void buzzer_apply(void)        /* sets duty from note_sounding / mute / volume */
{
  TIM3->CCR2 = (note_sounding && !muted && !paused) ? (cur_arr + 1u) * vol / 100u : 0u;
}

static void buzzer_freq(uint32_t hz)
{
  cur_arr = 1000000u / hz - 1u;
  TIM3->ARR = cur_arr;
  buzzer_apply();
}

/* ---------- tune ---------- */
typedef struct { uint16_t hz; uint16_t u; } note_t;   /* u = length in sixteenth notes */
static const note_t tune[] = {
  {523, 2}, {494, 2}, {523, 2}, {494, 1}, {523, 1},
  {494, 6}, {440, 4}, {392, 4}, {294, 10},
  {523, 2}, {494, 2}, {523, 2}, {494, 1}, {523, 1},
  {494, 6}, {440, 4}, {587, 4}, {440, 10},
};
#define N_NOTES (sizeof(tune) / sizeof(tune[0]))

static uint32_t bpm_now = 80;
static uint32_t pot_raw = 0;
static unsigned note_idx = N_NOTES - 1;   /* index of the note now sounding / last played */
static int phase = 1;                     /* 0 = note, 1 = short gap */
static uint32_t phase_end = 0, cur_len = 0;
static uint32_t cur_base_hz = 0;

static void tune_service(uint32_t now)
{
  if (paused) {
    if (note_sounding) { note_sounding = 0; buzzer_apply(); leds(0, 0); }
    phase = 1; phase_end = now;
    return;
  }
  if ((int32_t)(now - phase_end) < 0) return;

  if (phase == 0) {                       /* note over -> gap */
    note_sounding = 0; buzzer_apply(); leds(0, 0);
    phase = 1;
    phase_end = now + cur_len / 10;
  } else {                                /* gap over -> next note */
    note_idx = (note_idx + 1) % N_NOTES;
    uint32_t sixteenth = 15000u / bpm_now;
    cur_len = tune[note_idx].u * sixteenth;
    cur_base_hz = tune[note_idx].hz;
    if (cur_base_hz) {
      buzzer_freq(cur_base_hz * SHIFT);
      note_sounding = 1; buzzer_apply();
      leds(1, cur_base_hz >= 523);
    }
    phase = 0;
    phase_end = now + cur_len * 9 / 10;
  }
}

/* ---------- pulse sensor ---------- */
static int32_t p_raw, p_avg, p_lo, p_hi, p_thr;
static uint32_t p_bpm = 0, p_last_beat = 0;
static int p_above = 0;
static volatile int p_beat_flag = 0;

static void pulse_service(uint32_t now)
{
  p_raw = (int32_t)(adc_sum(ADC_CHANNEL_1, 64) / 4);      /* 16-bit scale */
  p_avg += (p_raw - p_avg) / 16;
  if (p_avg < p_lo) p_lo = p_avg; else p_lo += 1 + (p_hi - p_lo) / 400;
  if (p_avg > p_hi) p_hi = p_avg; else p_hi -= 1 + (p_hi - p_lo) / 400;
  if (p_hi < p_lo + 2) p_hi = p_lo + 2;
  p_thr = p_lo + (p_hi - p_lo) * 6 / 10;
  int32_t amp = p_hi - p_lo;

  if (!p_above && p_avg > p_thr && amp > 80) {
    p_above = 1;
    if (now - p_last_beat > 300) {
      if (p_last_beat != 0) {
        uint32_t b = 60000u / (now - p_last_beat);
        p_bpm = p_bpm ? (p_bpm * 2 + b) / 3 : b;
      }
      p_last_beat = now;
      p_beat_flag = 1;
    }
  } else if (p_above && p_avg < p_lo + (p_hi - p_lo) * 4 / 10) {
    p_above = 0;
  }
  if (p_bpm && now - p_last_beat > 3000) p_bpm = 0;
}

/* ---------- inputs ---------- */
static void inputs_init(void)
{
  GPIO_InitTypeDef g = {0};
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();
  __HAL_RCC_GPIOC_CLK_ENABLE();
  g.Mode = GPIO_MODE_INPUT;
  g.Speed = GPIO_SPEED_FREQ_LOW;
  for (unsigned i = 0; i < N_PINS; i++) {
    if (pins[i].pull == 2) continue;
    g.Pin = pins[i].pin;
    g.Pull = pins[i].pull ? GPIO_PULLUP : GPIO_NOPULL;
    HAL_GPIO_Init(pins[i].port, &g);
  }
}

static uint32_t read_mask(void)
{
  uint32_t m = 0;
  for (unsigned i = 0; i < N_PINS; i++)
    if (HAL_GPIO_ReadPin(pins[i].port, pins[i].pin)) m |= (1u << i);
  return m;
}

static void led_outputs_init(void)
{
  GPIO_InitTypeDef g = {0};
  __HAL_RCC_GPIOA_CLK_ENABLE();
  __HAL_RCC_GPIOB_CLK_ENABLE();
  g.Mode = GPIO_MODE_OUTPUT_PP;
  g.Pull = GPIO_NOPULL;
  g.Speed = GPIO_SPEED_FREQ_LOW;
  g.Pin = LED2_Pin; HAL_GPIO_Init(LED2_GPIO_Port, &g);
  g.Pin = LED3_Pin; HAL_GPIO_Init(LED3_GPIO_Port, &g);
}

/* ---------- actions (buttons and page commands) ---------- */
static void act_pause(uint32_t now) { paused = !paused; phase = 1; phase_end = now; buzzer_apply(); }
static void act_mute(void)          { muted = !muted; buzzer_apply(); }
static void act_vol(int d)
{
  int v = (int)vol + d;
  if (v < 1) v = 1;
  if (v > VOL_MAX) v = VOL_MAX;
  vol = (uint32_t)v;
  buzzer_apply();
}
static void act_restart(uint32_t now) { note_idx = N_NOTES - 1; phase = 1; phase_end = now; paused = 0; }

int main(void)
{
  char msg[240];
  uint32_t last_tele = 0, last_pot = 0, last_tick = 0;
  uint32_t mask = 0, prev_mask = 0;
  uint32_t lock_until[N_PINS] = {0};

  HAL_Init();
  SystemClock_Config();
  led_outputs_init();
  uart_init();
  adc_init();
  buzzer_init();
  inputs_init();
  tim6_init();

  p_raw = p_avg = (int32_t)(adc_sum(ADC_CHANNEL_1, 64) / 4);
  p_lo = p_hi = p_avg;
  pot_raw = adc_sum(ADC_CHANNEL_2, 8) / 8;
  prev_mask = read_mask();

  tx_str("# debug platform ready\r\n");

  while (1)
  {
    uint32_t now = HAL_GetTick();

    if (now - last_tick >= 2) {            /* 500 Hz loop */
      last_tick = now;
      pulse_service(now);
    }

    if (now - last_pot >= 40) {            /* pot -> tempo */
      last_pot = now;
      pot_raw = adc_sum(ADC_CHANNEL_2, 8) / 8;
      uint32_t target = BPM_MIN + pot_raw * (BPM_MAX - BPM_MIN) / 4095u;
      bpm_now = (bpm_now * 3u + target) / 4u;
    }

    /* buttons: act on the rising edge (pressed = HIGH), 150 ms lock-out against bounce */
    mask = read_mask();
    static const uint8_t btn[5] = {P_LEFT, P_DOWN, P_RIGHT, P_UP, P_B1};
    for (int k = 0; k < 5; k++) {
      int b = (mask >> btn[k]) & 1;
      int was = (prev_mask >> btn[k]) & 1;
      if (b && !was && (int32_t)(now - lock_until[btn[k]]) >= 0) {
        lock_until[btn[k]] = now + 150;        /* ignore contact bounce */
        if (btn[k] == P_UP)    act_vol(+5);
        if (btn[k] == P_DOWN)  act_vol(-5);
        if (btn[k] == P_LEFT)  act_pause(now);
        if (btn[k] == P_RIGHT) act_restart(now);
        if (btn[k] == P_B1)    act_mute();
      }
    }
    prev_mask = mask;

    while (rxt != rxh) {                   /* commands from the page, one per line */
      static char cmd[12];
      static uint8_t cl = 0;
      char c = (char)rxbuf[rxt];
      rxt = (uint8_t)((rxt + 1) % RXN);
      if (c == '\r') continue;
      if (c != '\n') { if (cl < sizeof cmd - 1) cmd[cl++] = c; continue; }
      cmd[cl] = 0; cl = 0;
      if (cmd[0] == 'm') act_mute();
      else if (cmd[0] == 'p') act_pause(now);
      else if (cmd[0] == '+') act_vol(+5);
      else if (cmd[0] == '-') act_vol(-5);
      else if (cmd[0] == 'r') act_restart(now);
      else if ((cmd[0] == '2' || cmd[0] == '3') && cmd[1] == ':') {
        int v = atoi(cmd + 2);
        if (v < 0) v = 0;
        if (v > 100) v = 100;
        uint8_t duty = (uint8_t)(v * v / 100);
        if (v > 0 && duty == 0) duty = 1;
        if (cmd[0] == '2') { led2_s = (uint8_t)v; led2_duty = duty; }
        else               { led3_s = (uint8_t)v; led3_duty = duty; }
      }
      else if ((cmd[0] == '2' || cmd[0] == '3') && cmd[1] == 'f') {
        if (cmd[0] == '2') led2_force = (cmd[2] == '1'); else led3_force = (cmd[2] == '1');
      }
    }

    tune_service(now);

    if (now - last_tele >= 20) {           /* 50 lines per second */
      last_tele = now;
      snprintf(msg, sizeof msg,
        "T,%lu,%lu,%lu,%lu,%lu,%d,%lu,%d,%d,%u,%u,%d,%d,%lu,%ld,%ld,%ld,%lu,%d,%d,%d,%d,%d\r\n",
        (unsigned long)now, (unsigned long)pot_raw, (unsigned long)bpm_now,
        (unsigned long)(note_sounding ? cur_base_hz * SHIFT : 0), (unsigned long)(note_sounding ? cur_base_hz : 0),
        (note_sounding && !muted && !paused) ? 1 : 0, (unsigned long)vol,
        muted, paused, (unsigned)note_idx, (unsigned)N_NOTES,
        led2_on, led3_on, (unsigned long)mask,
        (long)p_raw, (long)p_avg, (long)p_thr, (unsigned long)p_bpm, p_beat_flag,
        led2_s, led3_s, led2_force, led3_force);
      p_beat_flag = 0;
      tx_str(msg);
    }
  }
}

void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  HAL_PWREx_ControlVoltageScaling(PWR_REGULATOR_VOLTAGE_SCALE1_BOOST);

  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSI;
  RCC_OscInitStruct.HSIState = RCC_HSI_ON;
  RCC_OscInitStruct.HSICalibrationValue = RCC_HSICALIBRATION_DEFAULT;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSI;
  RCC_OscInitStruct.PLL.PLLM = RCC_PLLM_DIV4;
  RCC_OscInitStruct.PLL.PLLN = 85;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = RCC_PLLQ_DIV2;
  RCC_OscInitStruct.PLL.PLLR = RCC_PLLR_DIV2;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) Error_Handler();

  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK | RCC_CLOCKTYPE_SYSCLK
                              | RCC_CLOCKTYPE_PCLK1 | RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV1;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV1;
  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_4) != HAL_OK) Error_Handler();
}

void Error_Handler(void)
{
  __disable_irq();
  while (1) {}
}
